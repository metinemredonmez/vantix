{
  "name": "@vantix/contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Vantix NATS payload sözleşmesi — tek kaynak (JSON Schema). zod/serde/pydantic buradan üretilir.",
  "scripts": {
    "gen": "node codegen/generate.mjs",
    "test": "node --import tsx tests/conformance_ts.ts",
    "test:ts": "node --import tsx tests/conformance_ts.ts",
    "test:py": "uv run --with pydantic python tests/conformance_py.py"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  }
}
